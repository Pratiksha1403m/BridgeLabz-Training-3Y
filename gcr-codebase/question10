<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Travel Selection</title>
</head>

<body>

    <h1>Travel Selection Page</h1>

    <!-- Country Selection -->
    <label for="country">Country:</label>

    <select id="country">
        <option selected>India</option>
        <option>USA</option>
        <option>Japan</option>
        <option>France</option>
    </select>

    <br><br>

    <!-- State Selection -->
    <label for="state">State:</label>

    <select id="state">
        <option selected>Madhya Pradesh</option>
        <option>Uttar Pradesh</option>
        <option>Rajasthan</option>
        <option>Maharashtra</option>
    </select>

    <br><br>

    <!-- City Selection -->
    <label for="city">City:</label>

    <select id="city">
        <option selected>kosi kalan</option>
        <option>mathura</option>
        <option>Agra</option>
        <option>Delhi</option>
    </select>

    <br><br>

    <!-- Tourist Place Selection -->
    <label for="place">Favorite Tourist Place:</label>

    <select id="place">
        <option selected>Taj Mahal</option>
        <option>India Gate</option>
        <option>Red Fort</option>
        <option>Gateway of India</option>
    </select>

    <!-- Summary -->
    <p>
        My selected choices are India,kosi kalan, and Agra
        and my favorite tourist place is Taj Mahal.
    </p>

</body>
</html>