
class Student {
    constructor(name, marks) {
        this.name = name;
        this.marks = marks;
    }

    calculateAverage() {
        let total = this.marks.reduce((sum, mark) => {
            return sum + mark;
        }, 0);

        return total / this.marks.length;
    }

  
    getGrade() {
        let average = this.calculateAverage();

        if (average >= 80) return "A";
        else if (average >= 60) return "B";
        else if (average >= 40) return "C";
        else return "F";
    }
}


const student1 = new Student("Rahul", [80, 85, 90]);
const student2 = new Student("Priya", [65, 70, 75]);
const student3 = new Student("Aman", [30, 35, 40]);


[student1, student2, student3].forEach(student => {
    console.log("Name:", student.name);
    console.log("Average:", student.calculateAverage());
    console.log("Grade:", student.getGrade());
    console.log("----------------");
});
