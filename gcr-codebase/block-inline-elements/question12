<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Quotation Showcase</title>
</head>

<body>

    <h1>Quotation Showcase</h1>

    <!-- Quote 1 -->
    <section>
        <h2>Quote About Success</h2>

        <blockquote>
            "Success is not final, failure is not fatal."
        </blockquote>

        <p>
            <cite>Winston Churchill</cite>
        </p>
    </section>

    <!-- Quote 2 -->
    <section>
        <h2>Quote About Life</h2>

        <blockquote>
            "The purpose of our lives is to be happy."
        </blockquote>

        <p>
            <cite>Dalai Lama</cite>
        </p>
    </section>

    <!-- Quote 3 -->
    <section>
        <h2>Quote About Dreams</h2>

        <blockquote>
            "The future belongs to those who believe in their dreams."
        </blockquote>

        <p>
            <cite>Eleanor Roosevelt</cite>
        </p>
    </section>

    <!-- Summary -->
    <p>
        Quotes inspire people by giving them motivation, hope and
        positive thoughts. They can help us learn from the experiences
        and ideas of great people.
    </p>

</body>
</html>